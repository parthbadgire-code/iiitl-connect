# Prisma Connection URIs
# These variables should point to the Neon Postgres cloud database.
# DATABASE_URL is for standard migrations (pooled connections generally require pgbouncer setup or similar, but for Neon, the pooled URL might be used for standard queries).
# DIRECT_DATABASE_URL is used for direct connection (bypassing pooler) which is required for Prisma migrations.
DATABASE_URL="postgres://user:password@hostname:5432/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgres://user:password@hostname:5432/dbname?sslmode=require"

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

